# Python/test caches are reproducible local state, never project work.
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Doctor probes and bounded reconciliation scratch are non-authoritative.
data/.doctor_roundtrip_*
.codex-ops/temp/
.pre-commit-home/

# DVC descriptors are project authority; payload bytes stay outside Git.
/data/*
!/data/.gitignore
!/data/*.dvc
!/data/packages.dvc
/datasets/*
!/datasets/.gitignore
!/datasets/*.dvc
/models/*
!/models/model_sources.yaml
!/models/model_registry.json
/runs/
/logs/

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maskfactory.local/plan/completion_track_registry.schema.json",
  "title": "MaskFactory completion-track registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_id",
    "policy_version",
    "authoritative_spec",
    "authoritative_spec_sha256",
    "migration",
    "profiles",
    "throughput_gates",
    "sha256"
  ],
  "properties": {
    "schema_version": { "const": "1.1.0" },
    "registry_id": { "const": "maskfactory_completion_tracks" },
    "policy_version": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "authoritative_spec": {
      "const": "Plan/24_AUTONOMOUS_CORE_COMPLETION_AND_COMFYUI_BRIDGE.md"
    },
    "authoritative_spec_sha256": { "$ref": "#/$defs/sha256" },
    "migration": { "$ref": "#/$defs/migration" },
    "profiles": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/profile" },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": ["profile_id"],
            "properties": { "profile_id": { "const": "core_autonomous_runtime" } }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": ["profile_id"],
            "properties": { "profile_id": { "const": "independent_real_accuracy" } }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": ["profile_id"],
            "properties": { "profile_id": { "const": "scale_daz_maturity" } }
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "throughput_gates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": { "$ref": "#/$defs/throughputGate" }
    },
    "sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nonemptyUniqueStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from_schema_version",
        "from_registry_sha256",
        "migration_kind",
        "preserves_profile_required_item_ids",
        "preserves_existing_item_evidence"
      ],
      "properties": {
        "from_schema_version": { "const": "1.0.0" },
        "from_registry_sha256": {
          "const": "029c3fba47b6522721c915d95c007bd58daecba45dbf682b011fd441464092fc"
        },
        "migration_kind": { "const": "additive_blocking_gate" },
        "preserves_profile_required_item_ids": { "const": true },
        "preserves_existing_item_evidence": { "const": true }
      }
    },
    "campaignRequirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_engineering_missions",
        "minimum_mask_records",
        "minimum_consecutive_mixed_campaigns",
        "minimum_autonomous_preparation_percent",
        "maximum_routine_codex_handoffs_per_campaign",
        "minimum_codex_usage_reduction_percent",
        "maximum_duplicate_submissions_or_promotions",
        "required_terminal_reconciliation_percent",
        "required_local_lease_release_percent"
      ],
      "properties": {
        "minimum_engineering_missions": { "const": 25 },
        "minimum_mask_records": { "const": 100 },
        "minimum_consecutive_mixed_campaigns": { "const": 3 },
        "minimum_autonomous_preparation_percent": { "const": 80 },
        "maximum_routine_codex_handoffs_per_campaign": { "const": 1 },
        "minimum_codex_usage_reduction_percent": { "const": 70 },
        "maximum_duplicate_submissions_or_promotions": { "const": 0 },
        "required_terminal_reconciliation_percent": { "const": 100 },
        "required_local_lease_release_percent": { "const": 100 }
      }
    },
    "throughputGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_id",
        "blocking_profile_ids",
        "required_item_ids",
        "legacy_evidence_disposition",
        "incomplete_claim",
        "acceptance_schema",
        "acceptance_schema_sha256",
        "campaign_requirements"
      ],
      "properties": {
        "gate_id": { "const": "self_hosted_autonomy_throughput_v1" },
        "blocking_profile_ids": {
          "type": "array",
          "prefixItems": [{ "const": "core_autonomous_runtime" }],
          "minItems": 1,
          "maxItems": 1
        },
        "required_item_ids": {
          "type": "array",
          "minItems": 28,
          "maxItems": 28,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^MF-P6-(?:1[3-9])\\.[0-9]{2}$"
          }
        },
        "legacy_evidence_disposition": {
          "const": "preserved_but_insufficient_for_throughput_completion"
        },
        "incomplete_claim": {
          "const": "SELF_HOSTED_AUTONOMOUS_LLM_THROUGHPUT_INCOMPLETE"
        },
        "acceptance_schema": {
          "const": "configs/self_hosted_autonomy_acceptance_v1.schema.json"
        },
        "acceptance_schema_sha256": {
          "const": "e38905c0bcbd7f2710765c9db4109d341ff18de204b34e059dd4a02359dc791d"
        },
        "campaign_requirements": { "$ref": "#/$defs/campaignRequirements" }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "classification",
        "blocking_for_core_completion",
        "purpose",
        "completion_claim",
        "required_item_ids",
        "prerequisite_profile_ids",
        "allowed_evidence",
        "forbidden_claims",
        "excluded_core_dependencies"
      ],
      "properties": {
        "profile_id": {
          "enum": [
            "core_autonomous_runtime",
            "independent_real_accuracy",
            "scale_daz_maturity"
          ]
        },
        "classification": { "enum": ["required", "optional", "post_core"] },
        "blocking_for_core_completion": { "type": "boolean" },
        "purpose": { "type": "string", "minLength": 1 },
        "completion_claim": { "type": "string", "minLength": 1 },
        "required_item_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^MF-P[0-9]+-[A-Z0-9]+(?:\\.[0-9]+)?$" }
        },
        "prerequisite_profile_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "core_autonomous_runtime",
              "independent_real_accuracy",
              "scale_daz_maturity"
            ]
          }
        },
        "allowed_evidence": { "$ref": "#/$defs/nonemptyUniqueStrings" },
        "forbidden_claims": { "$ref": "#/$defs/nonemptyUniqueStrings" },
        "excluded_core_dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "human_anchor_masks",
              "manual_cvat_correction",
              "blinded_human_review",
              "minimum_package_corpus",
              "full_model_library_download",
              "daz_asset_or_render_work",
              "long_duration_daz_soak",
              "independent_real_accuracy_measurement"
            ]
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "profile_id": { "const": "core_autonomous_runtime" } } },
          "then": {
            "properties": {
              "classification": { "const": "required" },
              "blocking_for_core_completion": { "const": true },
              "prerequisite_profile_ids": { "maxItems": 0 },
              "excluded_core_dependencies": {
                "minItems": 8,
                "maxItems": 8
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "profile_id": {
                "enum": ["independent_real_accuracy", "scale_daz_maturity"]
              }
            }
          },
          "then": {
            "properties": {
              "blocking_for_core_completion": { "const": false },
              "excluded_core_dependencies": { "maxItems": 0 }
            }
          }
        }
      ]
    }
  }
}
